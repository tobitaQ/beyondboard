// App 3: detect anomalies with your own function in the cloud
// Arduino Cloud version: Arduino Cloud has no place to run code, so the sketch calls
// a function the user puts on AWS Lambda (function URL) over HTTPS, and uses the answer
// right away, as aws.run() does. The sketch Arduino Cloud generates, plus the lines the user writes.
// HTTPClient.h must come before thingProperties.h: otherwise, on macOS, the name matches
// HttpClient.h of ArduinoHttpClient (installed with Arduino Cloud) and the build fails.
#include <WiFiClientSecure.h>
#include <HTTPClient.h>
#include "arduino_secrets.h"
#include "thingProperties.h"

