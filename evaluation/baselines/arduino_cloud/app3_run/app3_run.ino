float readTemperature() {
  return 20.0 + random(0, 150) / 10.0;
}

String callFunction(String input) {
  WiFiClientSecure client;
  client.setCACert(ROOT_CA);
  HTTPClient http;
  http.begin(client, SECRET_FUNCTION_URL);
  http.addHeader("Content-Type", "text/plain");
  int code = http.POST(input);
  String body = code == 200 ? http.getString() : "error " + String(code);
  http.end();
  return body;
}

unsigned long last = 0;

void setup() {
  Serial.begin(9600);
  delay(1500);
  initProperties();
  ArduinoCloud.begin(ArduinoIoTPreferredConnection);
  setDebugMessageLevel(2);
  ArduinoCloud.printDebugInfo();
}

void loop() {
  ArduinoCloud.update();
  // delay() is discouraged with Arduino Cloud, so use millis().
  if (ArduinoCloud.connected() && millis() - last > 10000) {
    last = millis();
    temperature = readTemperature();
    String result = callFunction(String(temperature));
    Serial.print(temperature);
    Serial.print(" -> ");
    Serial.println(result);
  }
}
